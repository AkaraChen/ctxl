{
  "name": "yoi",
  "description": "Current deploy state and append-only deploy log. This is an example schema; the yoi binary is unchanged.",
  "entities": [
    {
      "name": "deploy",
      "kind": "singular",
      "format": "markdown",
      "path": "DEPLOY.md",
      "location": "root",
      "scope": "project",
      "description": "Current deploy. Reopen or copy to another machine.",
      "fields": [
        {"name": "service", "type": "string", "required": true, "description": "service name"},
        {"name": "port", "type": "string", "description": "listen port"},
        {"name": "start", "type": "string", "required": true, "description": "how to start"},
        {"name": "stop", "type": "string", "required": true, "description": "how to stop"},
        {"name": "last_green", "type": "string", "description": "last successful time"}
      ]
    },
    {
      "name": "log",
      "kind": "plural",
      "format": "ndjson",
      "path": "deploy.log",
      "location": "store",
      "scope": "project",
      "description": "Audit log. Failures and how many times it was installed.",
      "fields": [
        {"name": "id", "type": "int"},
        {"name": "ts", "type": "string"},
        {"name": "project", "type": "string"},
        {"name": "result", "type": "string", "required": true},
        {"name": "cmd", "type": "string", "required": true},
        {"name": "custom_data", "type": "object"}
      ]
    }
  ]
}
