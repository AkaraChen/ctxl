{
  "name": "demo",
  "description": "Example context layer: current status, a section in an existing file, a symlink, an append-only log, and a root-level markdown collection.",
  "entities": [
    {
      "name": "status",
      "kind": "singular",
      "format": "markdown",
      "write": "replace",
      "path": "STATUS.md",
      "location": "root",
      "scope": "project",
      "description": "Current status. Reopen or copy to another machine.",
      "fields": [
        {"name": "service", "type": "string", "required": true, "description": "service name"},
        {"name": "port", "type": "string", "description": "listen port"},
        {"name": "start", "type": "string", "required": true, "description": "how to start"},
        {"name": "stop", "type": "string", "required": true, "description": "how to stop"},
        {"name": "last_green", "type": "string", "description": "last successful time"}
      ]
    },
    {
      "name": "guide",
      "kind": "singular",
      "format": "markdown",
      "write": "section",
      "section": "Context",
      "path": "GUIDE.md",
      "location": "root",
      "scope": "project",
      "description": "One titled section in an existing markdown file."
    },
    {
      "name": "alias",
      "kind": "singular",
      "format": "symlink",
      "path": "ALIAS.md",
      "target": "GUIDE.md",
      "location": "root",
      "scope": "project",
      "description": "Symlink to the guide file."
    },
    {
      "name": "log",
      "kind": "plural",
      "format": "ndjson",
      "path": "events.log",
      "location": "store",
      "scope": "project",
      "description": "Append-only event log.",
      "fields": [
        {"name": "id", "type": "int"},
        {"name": "ts", "type": "string"},
        {"name": "project", "type": "string"},
        {"name": "result", "type": "string", "required": true},
        {"name": "cmd", "type": "string", "required": true},
        {"name": "custom_data", "type": "object"}
      ]
    },
    {
      "name": "note",
      "kind": "plural",
      "format": "markdown",
      "path": "docs/notes",
      "location": "root",
      "id": "id",
      "description": "One note per file under docs/notes/<id>.md",
      "fields": [
        {"name": "id", "type": "string", "required": true},
        {"name": "title", "type": "string", "required": true}
      ]
    }
  ]
}
